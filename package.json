{
  "name": "aurex-sftp",
  "displayName": "Aurex SFTP",
  "description": "Reliable SFTP / FTP / FTPS deploys: upload on save with conflict detection, a remote explorer with drag & drop, diff and previewed sync, and passwords kept in the OS keychain. Reads your existing .vscode/sftp.json.",
  "version": "0.4.0",
  "publisher": "amanazkar",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "sftp",
    "ftp",
    "ftps",
    "deploy",
    "upload",
    "sync",
    "remote"
  ],
  "icon": "media/logo.png",
  "galleryBanner": {
    "color": "#1e3a8a",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.vscode/sftp.json",
    "onFileSystem:aurex-sftp"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aurexSftp",
          "title": "Aurex SFTP",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "aurexSftp": [
        {
          "id": "aurexSftp.remoteExplorer",
          "name": "Servers"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "aurexSftp.remoteExplorer",
        "contents": "No servers configured for this workspace.\n[Add Server](command:aurexSftp.addServer)\nAlready using another SFTP extension? An existing .vscode/sftp.json is picked up automatically."
      }
    ],
    "commands": [
      {
        "command": "aurexSftp.addServer",
        "title": "Add Server\u2026",
        "category": "Aurex SFTP",
        "icon": "$(add)"
      },
      {
        "command": "aurexSftp.openConfig",
        "title": "Open Config (sftp.json)",
        "category": "Aurex SFTP",
        "icon": "$(gear)"
      },
      {
        "command": "aurexSftp.refresh",
        "title": "Refresh",
        "category": "Aurex SFTP",
        "icon": "$(refresh)"
      },
      {
        "command": "aurexSftp.menu",
        "title": "Show Actions\u2026",
        "category": "Aurex SFTP"
      },
      {
        "command": "aurexSftp.testConnection",
        "title": "Test Connection",
        "category": "Aurex SFTP",
        "icon": "$(plug)"
      },
      {
        "command": "aurexSftp.disconnect",
        "title": "Disconnect",
        "category": "Aurex SFTP",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "aurexSftp.disconnectAll",
        "title": "Disconnect All",
        "category": "Aurex SFTP"
      },
      {
        "command": "aurexSftp.moveSecretsToKeychain",
        "title": "Move Passwords from sftp.json to OS Keychain",
        "category": "Aurex SFTP"
      },
      {
        "command": "aurexSftp.forgetPassword",
        "title": "Forget Saved Password",
        "category": "Aurex SFTP"
      },
      {
        "command": "aurexSftp.switchProfile",
        "title": "Switch Profile\u2026",
        "category": "Aurex SFTP"
      },
      {
        "command": "aurexSftp.toggleUploadOnSave",
        "title": "Toggle Upload on Save",
        "category": "Aurex SFTP"
      },
      {
        "command": "aurexSftp.showLog",
        "title": "Show Log",
        "category": "Aurex SFTP"
      },
      {
        "command": "aurexSftp.upload",
        "title": "Upload to Server",
        "category": "Aurex SFTP",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "aurexSftp.download",
        "title": "Download from Server",
        "category": "Aurex SFTP",
        "icon": "$(cloud-download)"
      },
      {
        "command": "aurexSftp.diffWithRemote",
        "title": "Compare with Server",
        "category": "Aurex SFTP",
        "icon": "$(diff)"
      },
      {
        "command": "aurexSftp.syncToRemote",
        "title": "Sync Local \u2192 Server\u2026",
        "category": "Aurex SFTP",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "aurexSftp.syncToLocal",
        "title": "Sync Server \u2192 Local\u2026",
        "category": "Aurex SFTP",
        "icon": "$(cloud-download)"
      },
      {
        "command": "aurexSftp.remote.download",
        "title": "Download",
        "category": "Aurex SFTP",
        "icon": "$(cloud-download)"
      },
      {
        "command": "aurexSftp.remote.uploadHere",
        "title": "Upload Files Here\u2026",
        "category": "Aurex SFTP",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "aurexSftp.remote.newFile",
        "title": "New File\u2026",
        "category": "Aurex SFTP",
        "icon": "$(new-file)"
      },
      {
        "command": "aurexSftp.remote.newFolder",
        "title": "New Folder\u2026",
        "category": "Aurex SFTP",
        "icon": "$(new-folder)"
      },
      {
        "command": "aurexSftp.remote.rename",
        "title": "Rename\u2026",
        "category": "Aurex SFTP"
      },
      {
        "command": "aurexSftp.remote.delete",
        "title": "Delete",
        "category": "Aurex SFTP"
      },
      {
        "command": "aurexSftp.remote.chmod",
        "title": "Change Permissions\u2026",
        "category": "Aurex SFTP"
      },
      {
        "command": "aurexSftp.remote.copyPath",
        "title": "Copy Remote Path",
        "category": "Aurex SFTP"
      },
      {
        "command": "aurexSftp.remote.diffWithLocal",
        "title": "Compare with Local",
        "category": "Aurex SFTP"
      },
      {
        "command": "aurexSftp.remote.refresh",
        "title": "Refresh",
        "category": "Aurex SFTP",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aurexSftp.addServer",
          "when": "view == aurexSftp.remoteExplorer",
          "group": "navigation@1"
        },
        {
          "command": "aurexSftp.refresh",
          "when": "view == aurexSftp.remoteExplorer",
          "group": "navigation@2"
        },
        {
          "command": "aurexSftp.openConfig",
          "when": "view == aurexSftp.remoteExplorer",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "aurexSftp.remote.refresh",
          "when": "view == aurexSftp.remoteExplorer && viewItem =~ /^(profile|dir)/",
          "group": "inline@3"
        },
        {
          "command": "aurexSftp.remote.uploadHere",
          "when": "view == aurexSftp.remoteExplorer && viewItem =~ /^(profile|dir)/",
          "group": "inline@2"
        },
        {
          "command": "aurexSftp.testConnection",
          "when": "view == aurexSftp.remoteExplorer && viewItem =~ /^profile/",
          "group": "0_conn@1"
        },
        {
          "command": "aurexSftp.disconnect",
          "when": "view == aurexSftp.remoteExplorer && viewItem == profile-connected",
          "group": "0_conn@2"
        },
        {
          "command": "aurexSftp.switchProfile",
          "when": "view == aurexSftp.remoteExplorer && viewItem =~ /^profile/",
          "group": "0_conn@3"
        },
        {
          "command": "aurexSftp.syncToRemote",
          "when": "view == aurexSftp.remoteExplorer && viewItem =~ /^(profile|dir)/",
          "group": "1_sync@1"
        },
        {
          "command": "aurexSftp.syncToLocal",
          "when": "view == aurexSftp.remoteExplorer && viewItem =~ /^(profile|dir)/",
          "group": "1_sync@2"
        },
        {
          "command": "aurexSftp.remote.newFile",
          "when": "view == aurexSftp.remoteExplorer && viewItem =~ /^(profile|dir)/",
          "group": "2_new@1"
        },
        {
          "command": "aurexSftp.remote.newFolder",
          "when": "view == aurexSftp.remoteExplorer && viewItem =~ /^(profile|dir)/",
          "group": "2_new@2"
        },
        {
          "command": "aurexSftp.remote.uploadHere",
          "when": "view == aurexSftp.remoteExplorer && viewItem =~ /^(profile|dir)/",
          "group": "3_transfer@1"
        },
        {
          "command": "aurexSftp.remote.download",
          "when": "view == aurexSftp.remoteExplorer && viewItem =~ /^(file|dir)$/",
          "group": "3_transfer@2"
        },
        {
          "command": "aurexSftp.remote.diffWithLocal",
          "when": "view == aurexSftp.remoteExplorer && viewItem == file",
          "group": "3_transfer@3"
        },
        {
          "command": "aurexSftp.remote.rename",
          "when": "view == aurexSftp.remoteExplorer && viewItem =~ /^(file|dir)$/",
          "group": "4_edit@1"
        },
        {
          "command": "aurexSftp.remote.delete",
          "when": "view == aurexSftp.remoteExplorer && viewItem =~ /^(file|dir)$/",
          "group": "4_edit@2"
        },
        {
          "command": "aurexSftp.remote.chmod",
          "when": "view == aurexSftp.remoteExplorer && viewItem =~ /^(file|dir)$/",
          "group": "4_edit@3"
        },
        {
          "command": "aurexSftp.remote.copyPath",
          "when": "view == aurexSftp.remoteExplorer && viewItem =~ /^(file|dir)$/",
          "group": "5_copy@1"
        }
      ],
      "explorer/context": [
        {
          "command": "aurexSftp.upload",
          "when": "aurexSftp.hasConfig",
          "group": "aurexSftp@1"
        },
        {
          "command": "aurexSftp.download",
          "when": "aurexSftp.hasConfig",
          "group": "aurexSftp@2"
        },
        {
          "command": "aurexSftp.diffWithRemote",
          "when": "aurexSftp.hasConfig && !explorerResourceIsFolder",
          "group": "aurexSftp@3"
        },
        {
          "command": "aurexSftp.syncToRemote",
          "when": "aurexSftp.hasConfig && explorerResourceIsFolder",
          "group": "aurexSftp@4"
        },
        {
          "command": "aurexSftp.syncToLocal",
          "when": "aurexSftp.hasConfig && explorerResourceIsFolder",
          "group": "aurexSftp@5"
        }
      ],
      "editor/title/context": [
        {
          "command": "aurexSftp.upload",
          "when": "aurexSftp.hasConfig && resourceScheme == file",
          "group": "aurexSftp@1"
        },
        {
          "command": "aurexSftp.download",
          "when": "aurexSftp.hasConfig && resourceScheme == file",
          "group": "aurexSftp@2"
        },
        {
          "command": "aurexSftp.diffWithRemote",
          "when": "aurexSftp.hasConfig && resourceScheme == file",
          "group": "aurexSftp@3"
        }
      ],
      "editor/context": [
        {
          "command": "aurexSftp.upload",
          "when": "aurexSftp.hasConfig && resourceScheme == file",
          "group": "aurexSftp@1"
        },
        {
          "command": "aurexSftp.download",
          "when": "aurexSftp.hasConfig && resourceScheme == file",
          "group": "aurexSftp@2"
        },
        {
          "command": "aurexSftp.diffWithRemote",
          "when": "aurexSftp.hasConfig && resourceScheme == file",
          "group": "aurexSftp@3"
        }
      ],
      "commandPalette": [
        {
          "command": "aurexSftp.remote.download",
          "when": "false"
        },
        {
          "command": "aurexSftp.remote.uploadHere",
          "when": "false"
        },
        {
          "command": "aurexSftp.remote.newFile",
          "when": "false"
        },
        {
          "command": "aurexSftp.remote.newFolder",
          "when": "false"
        },
        {
          "command": "aurexSftp.remote.rename",
          "when": "false"
        },
        {
          "command": "aurexSftp.remote.delete",
          "when": "false"
        },
        {
          "command": "aurexSftp.remote.chmod",
          "when": "false"
        },
        {
          "command": "aurexSftp.remote.copyPath",
          "when": "false"
        },
        {
          "command": "aurexSftp.remote.diffWithLocal",
          "when": "false"
        },
        {
          "command": "aurexSftp.remote.refresh",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Aurex SFTP",
      "properties": {
        "aurexSftp.conflictDetection": {
          "type": "boolean",
          "default": true,
          "description": "Before uploading on save, check whether the server copy changed since you last synced it, and ask before overwriting."
        },
        "aurexSftp.checkOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "When you open a file, compare it with the server copy so you never edit an outdated file."
        },
        "aurexSftp.downloadOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "When an opened file differs from the server, load the server version automatically. If your local copy has changes the server doesn't, you're asked instead. A server's \"downloadOnOpen\" in sftp.json overrides this."
        },
        "aurexSftp.retries": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "description": "How many times to reconnect and retry an operation after the connection drops."
        },
        "aurexSftp.idleDisconnectSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "description": "Close idle connections after this many seconds (0 keeps them open)."
        },
        "aurexSftp.showUploadNotifications": {
          "type": "boolean",
          "default": false,
          "description": "Show a notification after each successful upload (the status bar always shows it)."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node esbuild.mjs --test && node dist/test/smoke.js",
    "test:e2e": "node esbuild.mjs && node test/integration/build.mjs && node dist/test/integration/run.js",
    "package": "npm run typecheck && node esbuild.mjs --production && vsce package --no-dependencies"
  },
  "dependencies": {
    "basic-ftp": "^5.0.5",
    "ignore": "^5.3.2",
    "jsonc-parser": "^3.3.1",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/ssh2": "^1.15.1",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "ftp-srv": "^4.6.3",
    "typescript": "^5.6.3"
  },
  "author": {
    "name": "Aman Azkar"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AAzkar/aurex-sftp.git"
  },
  "bugs": {
    "url": "https://github.com/AAzkar/aurex-sftp/issues"
  },
  "homepage": "https://github.com/AAzkar/aurex-sftp#readme"
}
